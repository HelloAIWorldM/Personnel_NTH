rules_version = '2';

/**
 * Cloud Firestore Security Rules for Project `sapxepnhansunth`
 * Guild Personnel & Raid Management (Sắp Xếp Nhân Sự Bang NTH)
 *
 * ===============================================================
 * Assumed Data Models
 * ===============================================================
 *
 * Collection: /guilds/{guildId}
 * Document ID: string (1-128 chars, matching '^[a-zA-Z0-9_.-]+$')
 * Fields:
 *   - boards: list (required, max 100 items) - Raid rosters/boards
 *   - personnelPool: list (required, max 1000 items) - Member roster pool
 *   - guildWarBoards: list (required, max 100 items) - Guild war tactical boards
 *   - activeBoardId: string (required, max 128 chars) - Currently active raid board
 *   - activeGuildWarBoardId: string (required, max 128 chars) - Currently active guild war board
 *   - customColors: map (required, max 50 keys) - Color mappings
 *   - updatedAt: timestamp | int | float (required, >= 0) - Last sync timestamp
 *   - title: string (optional, max 200 chars) - Room/board display title
 *   - updateBoards: list (optional, max 100 items) - Raid update rosters
 *   - updatePersonnelPool: list (optional, max 1000 items) - Raid update pool
 *   - activeUpdateBoardId: string (optional, max 128 chars) - Active update board ID
 *   - diBuiPersonnelPool: list (optional, max 1000 items) - Di Bụi personnel pool
 *   - masterPersonnelPool: list (optional, max 1000 items) - Master personnel pool
 *   - guildWarPersonnelPool: list (optional, max 1000 items) - Guild war personnel pool
 *
 * ===============================================================
 * Security Architecture & Invariants:
 * 1. Default Deny: All paths are locked down by default at the root.
 * 2. Authenticated Guild Access: Reading, creating, and updating strictly require an authenticated
 *    Firebase Auth session (`request.auth != null`) alongside a valid guild room ID ({guildId}).
 * 3. Validator Function Pattern: Domain validators enforced to eliminate Update Bypass vulnerabilities.
 * 4. Strict Type Safety: Every field is explicitly type-checked (list, string, map, timestamp/number).
 * 5. Resource Exhaustion & DoS Prevention: Strict bounds on array lengths, string lengths, and map size.
 * 6. Schema Whitelisting: Strict key enforcement using `hasAll` for required keys and `hasOnly`
 *    to prevent property injection or arbitrary data pollution.
 * 7. Deletion Protection: Deleting guild rooms is hard-denied.
 * ===============================================================
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // DEFAULT DENY: Deny all reads and writes across all paths by default
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // HELPER FUNCTIONS & DOMAIN VALIDATORS - GUILDS
    // =========================================================================

    // Validate guild ID / room code format & length bounds
    function isValidGuildId(guildId) {
      return guildId is string
        && guildId.size() >= 1
        && guildId.size() <= 128
        && guildId.matches('^[a-zA-Z0-9_.-]+$');
    }

    // Validate that document contains only permitted fields and all required fields
    function hasValidGuildKeys(data) {
      return data.keys().hasAll([
        'boards',
        'personnelPool',
        'guildWarBoards',
        'activeBoardId',
        'activeGuildWarBoardId',
        'customColors',
        'updatedAt'
      ]) && data.keys().hasOnly([
        'boards',
        'personnelPool',
        'guildWarBoards',
        'activeBoardId',
        'activeGuildWarBoardId',
        'customColors',
        'updatedAt',
        'title',
        'updateBoards',
        'updatePersonnelPool',
        'activeUpdateBoardId',
        'diBuiPersonnelPool',
        'masterPersonnelPool',
        'guildWarPersonnelPool'
      ]);
    }

    // Validate timestamp or positive epoch number for updatedAt
    function isValidUpdatedAt(data) {
      return (data.updatedAt is timestamp)
        || ((data.updatedAt is int || data.updatedAt is float) && data.updatedAt >= 0);
    }

    // Validate optional title field if present
    function isValidTitle(data) {
      return !('title' in data)
        || (data.title is string && data.title.size() <= 200);
    }

    // Master Domain Validator for Guild Room Documents
    // Applied to BOTH create and update to prevent Update Bypass
    function isValidGuildDoc(data, guildId) {
      return isValidGuildId(guildId)
        && hasValidGuildKeys(data)
        // Array collections with bounds to prevent DoS / Resource Exhaustion
        && data.boards is list
        && data.boards.size() <= 100
        && data.personnelPool is list
        && data.personnelPool.size() <= 1000
        && data.guildWarBoards is list
        && data.guildWarBoards.size() <= 100
        // Active board identifiers
        && data.activeBoardId is string
        && data.activeBoardId.size() <= 128
        && data.activeGuildWarBoardId is string
        && data.activeGuildWarBoardId.size() <= 128
        // Custom colors map
        && data.customColors is map
        && data.customColors.keys().size() <= 50
        // Update timestamp & title
        && isValidUpdatedAt(data)
        && isValidTitle(data)
        // Optional Raid Update & Di Bụi synchronization fields
        && (!('updateBoards' in data) || (data.updateBoards is list && data.updateBoards.size() <= 100))
        && (!('updatePersonnelPool' in data) || (data.updatePersonnelPool is list && data.updatePersonnelPool.size() <= 1000))
        && (!('activeUpdateBoardId' in data) || (data.activeUpdateBoardId is string && data.activeUpdateBoardId.size() <= 128))
        && (!('diBuiPersonnelPool' in data) || (data.diBuiPersonnelPool is list && data.diBuiPersonnelPool.size() <= 1000))
        // Optional Master Personnel Pool & Guild War Personnel Pool fields
        && (!('masterPersonnelPool' in data) || (data.masterPersonnelPool is list && data.masterPersonnelPool.size() <= 1000))
        && (!('guildWarPersonnelPool' in data) || (data.guildWarPersonnelPool is list && data.guildWarPersonnelPool.size() <= 1000));
    }

    // =========================================================================
    // GUILD ROOMS COLLECTION: /guilds/{guildId}
    // =========================================================================
    match /guilds/{guildId} {
      // Authenticated room access: require authenticated Firebase Auth user and valid room code
      allow read: if request.auth != null && isValidGuildId(guildId);

      // Create and Update must be authenticated and satisfy the exact same domain validator
      // to eliminate the Update Bypass vulnerability
      allow create: if request.auth != null && isValidGuildDoc(request.resource.data, guildId);
      allow update: if request.auth != null && isValidGuildDoc(request.resource.data, guildId);

      // Hard-deny deletion to prevent malicious or accidental room destruction
      allow delete: if false;

      // =======================================================================
      // SNAPSHOTS SUBCOLLECTION: /guilds/{guildId}/snapshots/{snapshotId}
      // =======================================================================
      match /snapshots/{snapshotId} {
        // Authenticated members can read snapshots for their guild room
        allow read: if request.auth != null && isValidGuildId(guildId);
        // Client-direct writes are denied; snapshots must be generated via Backend API
        allow write: if false;
      }
    }
  }
}
